# ── PostgreSQL（Neon推奨：neon.tech で無料プランあり）──────────────────────
DATABASE_URL=postgresql://user:password@ep-xxx-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── メール（Hostinger）──────────────────────────────────────────────────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=noreply@chatlogi.jp
SMTP_PASS=your_email_password
SMTP_FROM=Chat LOGI <noreply@chatlogi.jp>
ADMIN_EMAIL=info@sinjapan.jp

# ── Square 決済 ─────────────────────────────────────────────────────────────
SQUARE_ACCESS_TOKEN=...
SQUARE_APPLICATION_ID=...
SQUARE_LOCATION_ID=...
SQUARE_ENVIRONMENT=production

# ── セッション ───────────────────────────────────────────────────────────────
SESSION_SECRET=最低32文字以上のランダム文字列をここに

# ── サーバー ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=production
SITE_URL=https://chatlogi.jp
