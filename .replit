modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
SQUARE_APPLICATION_ID = "sq0idp-1jhJxAU2UTUbQetbDA7CPQ"
SQUARE_ENVIRONMENT = "production"
SQUARE_LOCATION_ID = "LD95R63AEZZRH"
APP_BASE_URL = "https://chat-logi.com"
SMTP_FROM = "Chat LOGI <info@chat-logi.com>"
SMTP_HOST = "smtp.hostinger.com"
SMTP_PORT = "465"
SMTP_USER = "info@chat-logi.com"
